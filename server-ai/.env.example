# ==================================================================
# study-agent AI 服务环境变量模板
# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，切勿提交真实 Key）
# ==================================================================

# ---------------- 应用 ----------------
APP_NAME=study-agent-ai
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---------------- 阿里云百炼（DashScope，OpenAI 兼容协议） ----------------
# 思考模型：响应中 reasoning_content（思维链）与 content（正式回答）分开返回
DASHSCOPE_API_KEY=sk-ws-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-flash
# qwen3.7-flash 是思考模型：LangChain 默认丢弃 reasoning_content，
# 设为 true 时启动自动打透传补丁（详见 app/core/llm.py 顶部实测说明）
PRESERVE_REASONING=true

# ---------------- 本地开源模型（HuggingFace 镜像） ----------------
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 留空表示使用 HF 默认缓存 C:\Users\<user>\.cache\huggingface
MODEL_CACHE_DIR=
# true：模型只从本地缓存加载，缺失时立刻返回 503，绝不在请求里联网下载几 GB
# false：允许请求内按需下载（开发期方便，但会长时间阻塞请求）
MODEL_LOCAL_FILES_ONLY=true
# 完全离线模式。默认 false：bge-m3 的 imgs/.DS_Store 在镜像上恒 403，
# snapshot 永远不「完整」，离线模式下会抛 IncompleteSnapshotError
HF_HUB_OFFLINE=false

# ---------------- MySQL（本周不连接，仅预留） ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=study_agent

# ---------------- Redis（本周不连接，仅预留） ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------- Milvus（Lite 本地文件模式，免 Docker） ----------------
MILVUS_URI=./data/milvus_study.db
MILVUS_COLLECTION=kb_chunk

# ---------------- 与 Java 侧互调 ----------------
JAVA_BASE_URL=http://127.0.0.1:8080
INTERNAL_TOKEN=study-agent-internal
